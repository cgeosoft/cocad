*.[jJ][pP][gG] filter=lfs diff=lfs merge=lfs -text
*.[jJ][pP][eE][gG] filter=lfs diff=lfs merge=lfs -text
*.[pP][nN][gG] filter=lfs diff=lfs merge=lfs -text
*.[mM][pP]4 filter=lfs diff=lfs merge=lfs -text
*.[sS][tT][lL] filter=lfs diff=lfs merge=lfs -text
*.3[mM][fF] filter=lfs diff=lfs merge=lfs -text
# README image and tour screenshots: plain git, so GitHub shows them and the build needs no LFS
/assets/preview.png -filter -diff -merge -text
assets/tour/** -filter -diff -merge -text
# Website image sources: plain git
extras/website/images/** -filter -diff -merge -text
# Website images: plain git, so that Cloudflare Pages can build from the repo
extras/website/public/**/*.png -filter -diff -merge -text
# Guide pictures: plain git, so the wiki shows them
assets/guide/** -filter -diff -merge -text
# Window icon: plain git, so the build needs no LFS
/assets/icon.png -filter -diff -merge -text
# Built-in example thumbnails: plain git, so the build needs no LFS
assets/examples/** -filter -diff -merge -text
# Pictures of the print fix info windows: plain git, so the build needs no LFS
assets/fixes/** -filter -diff -merge -text
